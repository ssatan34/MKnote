{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Sticky Note",
  "version": "5.2.4",
  "identifier": "com.sin.md-sticky-note",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MKNOTE",
        "width": 760,
        "height": 640,
        "minWidth": 700,
        "minHeight": 440,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost http://localhost:1420",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$EXE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
