{
  "name": "md-sticky-note",
  "private": true,
  "version": "5.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:quick-todo": "node --test --test-isolation=none tests/quickTodo.test.ts",
    "test:quick-pocket": "node --test --test-isolation=none tests/quickPocket.test.ts",
    "test:quick-input": "node --test --test-isolation=none tests/quickInput.test.ts",
    "test:lsky-cleanup": "node --test --test-isolation=none tests/lskyCleanup.test.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:green": "powershell -ExecutionPolicy Bypass -File scripts/build-green.ps1",
    "smoke:release": "powershell -ExecutionPolicy Bypass -File scripts/smoke-release.ps1",
    "smoke:release:input": "powershell -ExecutionPolicy Bypass -File scripts/smoke-release.ps1 -VerifyInputSave",
    "pack:dev": "powershell -ExecutionPolicy Bypass -File scripts/pack-dev.ps1",
    "collect:visual-editor-t4": "node scripts/collect-visual-editor-t4-evidence.mjs",
    "collect:visual-editor-t4-process-memory": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-visual-editor-t4-process-memory.ps1",
"collect:visual-editor-t4-save-cas": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-visual-editor-t4-save-cas.ps1", "collect:visual-editor-t4-save-cas-ui": "node scripts/collect-visual-editor-t4-save-cas-ui.mjs",
    "test:visual-editor-registry": "node --test --test-isolation=none tests/visualEditorScenarioRegistry.test.ts"
  },
  "dependencies": {
    "@milkdown/kit": "7.19.2",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "^1.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@milkdown/transformer": "7.19.2",
    "@types/mdast": "4.0.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.8.3",
    "vite": "^5.4.11"
  }
}
